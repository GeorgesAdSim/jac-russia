<div class="hero hero-small">
  <div class="hero-inner">
    <h1>Ферментаторы для закваски</h1>
    <p>Ферментаторы для производства жидкой закваски</p>
  </div>
</div>

<div class="container">
  <div class="subcategories">
    <a class="subcat-badge active" href="/testoobrabotka/fermenty/">Ферментаторы для закваски</a>
    <a class="subcat-badge" href="/testoobrabotka/gidravlicheskie-deliteli/">Гидравлические делители</a>
    <a class="subcat-badge" href="/testoobrabotka/deliteli-formovshiki/">Делители-формовщики</a>
    <a class="subcat-badge" href="/testoobrabotka/presy-dlya-testa/">Прессы для теста</a>
    <a class="subcat-badge" href="/testoobrabotka/avtomat-deliteli/">Автоматические делители</a>
    <a class="subcat-badge" href="/testoobrabotka/shkafi-rasstoyki/">Шкафы расстойки</a>
    <a class="subcat-badge" href="/testoobrabotka/testoformovochnye/">Тестоформовочные машины</a>
    <a class="subcat-badge" href="/testoobrabotka/avtomatizirovannye-linii/">Автоматизированные линии</a>
  </div>
</div>

<div class="container">
  <div class="products-grid">
{%- for product in products | mainProductsOnly %}
  {%- set inCat = false %}
  {%- for catId in product.categories %}
    {%- if catId == "8" %}{%- set inCat = true %}{%- endif %}
  {%- endfor %}
  {%- if inCat %}
    <a class="product-card" href="/testoobrabotka/fermenty/{{ product.url_key }}/">
      {%- if product.images.length > 0 %}
        <img src="{{ product.images[0] }}" alt="{{ product.name }}" loading="lazy">
      {%- else %}
        <div class="no-image">Нет фото</div>
      {%- endif %}
      <div class="prod-body">
        <h3>{{ product.name }}</h3>
        <p class="desc">{{ product.short_description | striptags | truncate(100) }}</p>
        <span class="btn-devis-small">Подробнее →</span>
      </div>
    </a>
  {%- endif %}
{%- endfor %}
  </div>
</div>
