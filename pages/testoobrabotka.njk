---
layout: base.njk
title: Оборудование для тестообработки
---

<nav class="breadcrumb__container container">
  <ul class="breadcrumb">
    <li class="breadcrumb__item"><a href="/">Главная</a></li>
    <li class="breadcrumb__item breadcrumb__item--active">Оборудование для тестообработки</li>
  </ul>
</nav>

<div class="hero hero-small">
  <div class="hero-inner">
    <h1>Оборудование для тестообработки</h1>
    <p>Делители, формовщики, ферментаторы и автоматизированные линии</p>
  </div>
</div>

<div class="container">
  <div class="subcategories">
    <button class="subcat-badge active" data-filter="8">Ферментаторы для закваски</button>
    <button class="subcat-badge" data-filter="9">Гидравлические делители</button>
    <button class="subcat-badge" data-filter="12">Делители-формовщики</button>
    <button class="subcat-badge" data-filter="16">Прессы для теста</button>
    <button class="subcat-badge" data-filter="10">Автоматические делители</button>
    <button class="subcat-badge" data-filter="11">Шкафы расстойки</button>
    <button class="subcat-badge" data-filter="13">Тестоформовочные машины</button>
    <button class="subcat-badge" data-filter="14">Автоматизированные линии</button>
  </div>
</div>

<div class="container">
  <div class="products-grid" id="products-grid">
{% for product in products | mainProductsOnly %}
  {% set inCategory = false %}
  {% set productSubcat = "" %}
  {% for catId in product.categories %}
    {% if catId == "8" or catId == "9" or catId == "10" or catId == "11" or catId == "12" or catId == "13" or catId == "14" or catId == "16" %}
      {% set inCategory = true %}
      {% set productSubcat = catId %}
    {% endif %}
  {% endfor %}
  {% if inCategory %}
    <a class="product-card" href="/produit/{{ product.id }}-{{ product.url_key }}/" data-subcat="{{ productSubcat }}">
      {% if product.images.length > 0 %}
        <img src="{{ product.images[0] }}" alt="{{ product.name }}" loading="lazy">
      {% else %}
        <div class="no-image">Нет фото</div>
      {% endif %}
      <div class="prod-body">
        <h3>{{ product.name }}</h3>
        <p class="desc">{{ product.short_description | striptags | truncate(100) }}</p>
        <span class="btn-devis-small">Подробнее →</span>
      </div>
    </a>
  {% endif %}
{% endfor %}
  </div>
  <div class="pagination" id="pagination"></div>
</div>

<script>
(function() {
  var PER_PAGE = 20;
  var grid = document.getElementById('products-grid');
  var paginationEl = document.getElementById('pagination');
  var buttons = document.querySelectorAll('.subcat-badge[data-filter]');
  if (!grid) return;

  var allCards = Array.from(grid.querySelectorAll('.product-card'));
  var activeFilter = '8';
  var currentPage = 1;

  function getFilteredCards() {
    return allCards.filter(function(card) {
      return card.getAttribute('data-subcat') === activeFilter;
    });
  }

  function showPage(page) {
    currentPage = page;
    var filtered = getFilteredCards();
    var start = (page - 1) * PER_PAGE;
    var end = start + PER_PAGE;
    allCards.forEach(function(card) { card.style.display = 'none'; });
    filtered.forEach(function(card, i) {
      card.style.display = (i >= start && i < end) ? '' : 'none';
    });
    renderPagination(filtered.length);
    window.scrollTo({ top: grid.offsetTop - 120, behavior: 'smooth' });
  }

  function createPageLink(page, label) {
    var a = document.createElement('a');
    a.href = '#';
    a.setAttribute('data-page', String(page));
    a.textContent = label || String(page);
    a.addEventListener('click', function(e) {
      e.preventDefault();
      showPage(parseInt(this.getAttribute('data-page'), 10));
    });
    return a;
  }

  function renderPagination(total) {
    paginationEl.textContent = '';
    var totalPages = Math.ceil(total / PER_PAGE);
    if (totalPages <= 1) return;
    if (currentPage > 1) {
      paginationEl.appendChild(createPageLink(currentPage - 1, '\u00AB'));
    }
    for (var i = 1; i <= totalPages; i++) {
      if (i === currentPage) {
        var span = document.createElement('span');
        span.className = 'pagination-current';
        span.textContent = String(i);
        paginationEl.appendChild(span);
      } else if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) {
        paginationEl.appendChild(createPageLink(i));
      } else if (Math.abs(i - currentPage) === 3) {
        var dots = document.createElement('span');
        dots.className = 'pagination-ellipsis';
        dots.textContent = '...';
        paginationEl.appendChild(dots);
      }
    }
    if (currentPage < totalPages) {
      paginationEl.appendChild(createPageLink(currentPage + 1, '\u00BB'));
    }
  }

  buttons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      buttons.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activeFilter = btn.getAttribute('data-filter');
      currentPage = 1;
      showPage(1);
    });
  });

  showPage(1);
})();
</script>
